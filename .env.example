# Copy to .env before running `docker compose up --build` if you want to
# override the defaults. Docker Compose reads this file automatically.

# MySQL password for the non-root application user.
MYSQL_PASSWORD=imageedit_pass

# MySQL root password (only used by the database container itself).
MYSQL_ROOT_PASSWORD=root_pass

# Default simulated stage durations in milliseconds (0 - 600000).
SIM_CHECK_DELAY_MS=1200
SIM_GENERATE_DELAY_MS=2000
SIM_FINALIZE_DELAY_MS=1200

# Deterministically fail every newly accepted task at one stage:
# leave empty for success, or use CHECK / GENERATE / FINALIZE.
SIM_FAIL_STAGE=
